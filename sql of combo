ALTER TABLE select_master RENAME COLUMN html_tag TO s_html_tag;

SELECT 
    s.select_id,
    s.field_name,
    s.s_html_tag,
    s.html_name,
    s.html_id,
    o.html_tag,
    o.html_type,
    o.html_value,
    o.html_label,
    parent_id
FROM
    select_master s
        JOIN
    option_master o ON s.select_id = o.select_id
WHERE
    field_name = 'gender';


